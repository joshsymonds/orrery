{
  "meta": {
    "name": "orrery design tokens",
    "status": "draft, not rendered: no mockup has been drawn with these values yet",
    "units": "lengths are px numbers (dp and sp on Android), colours are #rrggbb, alphas are 0..1, durations are ms",
    "references": "a string value of the form {group.name} names another token and resolves to its value",
    "css": "a generator writes each leaf as a custom property: color.ink.1 becomes --o-color-ink-1",
    "compose": "a generator writes one object per top-level group: color.ink.1 becomes OrreryTokens.Color.Ink1"
  },

  "palette": {
    "crust": "#11111b",
    "mantle": "#181825",
    "base": "#1e1e2e",
    "surface0": "#313244",
    "surface1": "#45475a",
    "overlay0": "#6c7086",
    "overlay1": "#7f849c",
    "overlay2": "#9399b2",
    "subtext0": "#a6adc8",
    "text": "#cdd6f4",
    "lavender": "#b4befe",
    "blue": "#89b4fa",
    "teal": "#94e2d5",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "peach": "#fab387",
    "maroon": "#eba0ac",
    "red": "#f38ba8",
    "mauve": "#cba6f7"
  },

  "color": {
    "surface": {
      "side": "{palette.crust}",
      "well": "{palette.mantle}",
      "page": "{palette.base}",
      "raised": "{palette.surface0}",
      "pressed": "{palette.surface1}",
      "overlay": "{palette.mantle}"
    },
    "line": {
      "soft": "{palette.surface0}",
      "firm": "{palette.surface1}",
      "glyph": "{palette.overlay0}"
    },
    "ink": {
      "1": "{palette.text}",
      "2": "{palette.subtext0}",
      "3": "{palette.overlay2}",
      "4": "{palette.overlay1}",
      "onAccent": "{palette.crust}"
    },
    "role": {
      "you": "{palette.mauve}",
      "focus": "{palette.mauve}",
      "primary": "{palette.mauve}",
      "place": "{palette.mauve}",
      "attention": "{palette.peach}",
      "live": "{palette.yellow}",
      "ok": "{palette.green}",
      "bad": "{palette.red}",
      "halt": "{palette.maroon}",
      "engine": "{palette.teal}",
      "ref": "{palette.blue}",
      "new": "{palette.lavender}",
      "mark": "{palette.yellow}"
    },
    "state": {
      "working": "{color.role.live}",
      "waiting": "{color.role.attention}",
      "held": "{color.role.attention}",
      "done": "{color.role.ok}",
      "interrupted": "{color.role.halt}",
      "interrupting": "{color.role.halt}",
      "failed": "{color.role.bad}",
      "stopped": "{color.ink.3}",
      "idle": "{color.ink.3}",
      "paused": "{color.ink.3}"
    },
    "tone": {
      "plan": "{color.line.firm}",
      "run": "{color.role.live}",
      "mine": "{color.role.attention}",
      "bad": "{color.role.bad}",
      "acc": "{color.role.engine}",
      "ok": "{color.role.ok}"
    },
    "level": {
      "ok": "{palette.lavender}",
      "warn": "{palette.peach}",
      "crit": "{palette.red}"
    },
    "band": {
      "1": "{palette.green}",
      "2": "{palette.yellow}",
      "3": "{palette.peach}",
      "4": "{palette.red}"
    }
  },

  "rule": {
    "band": {
      "note": "context percent of window, clamped 0..100; band N applies below its limit, band 4 from 80",
      "limits": [40, 60, 80],
      "blocks": 5,
      "percentPerBlock": 20
    },
    "level": {
      "note": "a host stat's level is given by the server as ok, warn or crit; any other value draws as ok"
    }
  },

  "alpha": {
    "tintFill": 0.1,
    "tintLine": 0.35,
    "newTint": 0.06,
    "scrim": 0.6
  },

  "font": {
    "family": {
      "mono": "Orrery Mono",
      "fallback": ["ui-monospace", "JetBrains Mono", "Menlo", "monospace"]
    },
    "weight": {
      "regular": 400,
      "bold": 700
    }
  },

  "type": {
    "label": { "size": 11, "line": 16, "weight": "{font.weight.bold}", "tracking": 0.08, "caps": true },
    "small": { "size": 12, "line": 18, "weight": "{font.weight.regular}", "tracking": 0, "caps": false },
    "body": { "size": 14, "line": 22, "weight": "{font.weight.regular}", "tracking": 0, "caps": false },
    "title": { "size": 16, "line": 24, "weight": "{font.weight.bold}", "tracking": 0, "caps": false },
    "display": { "size": 22, "line": 28, "weight": "{font.weight.bold}", "tracking": 0, "caps": false }
  },

  "space": {
    "2": 2,
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "24": 24,
    "32": 32,
    "48": 48
  },

  "radius": {
    "1": 4,
    "2": 8,
    "3": 12,
    "round": 999
  },

  "size": {
    "hairline": 1,
    "thread": 1,
    "rail": 3,
    "glyph": 16,
    "dot": 6,
    "meterBar": 2,
    "contextBlock": 7,
    "controlDesk": 28,
    "controlTouch": 48,
    "markSmall": 18,
    "markLarge": 22,
    "orreryMini": 28,
    "orreryFull": 320
  },

  "layout": {
    "breakpointPhone": 760,
    "breakpointNarrow": 1250,
    "inboxWidth": 340,
    "inboxWidthNarrow": 316,
    "readMeasureCh": 88,
    "gutterCh": 5,
    "gutterGap": 16,
    "pageMeasure": 1120,
    "pagePadDesk": 24,
    "pagePadPhone": 16,
    "turnGap": 32,
    "itemGap": 12,
    "lineGap": 0
  },

  "elevation": {
    "overlay": { "x": 0, "y": 8, "blur": 24, "color": "{palette.crust}", "alpha": "{alpha.scrim}" },
    "side": { "x": 8, "y": 0, "blur": 24, "color": "{palette.crust}", "alpha": "{alpha.scrim}" }
  },

  "z": {
    "page": 0,
    "flyout": 10,
    "menu": 20,
    "notices": 30,
    "panel": 40
  },

  "motion": {
    "ease": {
      "out": [0.2, 0, 0, 1],
      "in": [0.4, 0, 1, 1],
      "linear": [0, 0, 1, 1]
    },
    "move": {
      "press": { "ms": 120, "ease": "{motion.ease.out}" },
      "state": { "ms": 200, "ease": "{motion.ease.out}" },
      "layout": { "ms": 280, "ease": "{motion.ease.out}" },
      "drill": { "ms": 320, "ease": "{motion.ease.out}" },
      "leave": { "ms": 200, "ease": "{motion.ease.in}" }
    },
    "loop": {
      "spin": { "ms": 1100, "ease": "{motion.ease.linear}" },
      "pulse": { "ms": 1800, "from": 1, "to": 0.25 },
      "blink": { "ms": 1100, "onShare": 0.55 }
    },
    "reduced": {
      "note": "with reduced motion every move is one linear step of this length and every loop holds still",
      "ms": 100
    },
    "distance": {
      "drill": 16
    }
  }
}

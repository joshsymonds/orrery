{
  "meta": {
    "name": "orrery design tokens",
    "status": "round 6: drawn. Every value here is used by web/visual/wireframe/round6, whose stylesheet reads only the generated variables.",
    "units": "lengths are px numbers (dp on Android, sp for type), colours are #rrggbb, alphas are 0..1, durations are ms",
    "references": "a string value of the form {group.name} names another token and resolves to its value",
    "css": "gen-tokens.mjs writes each leaf as a custom property: ink.1 becomes --o-ink-1, space.8 becomes --o-space-8. A type entry becomes one font shorthand, --o-type-body. Each role and each series colour also gets -fill and -line, its tint at alpha.tintFill and alpha.tintLine; a state, a tone and a level are drawn solid. A ground is its tint at its alpha mixed over its surface, as color-mix: ground.open becomes --o-ground-open. The same properties and the reduced-motion block go to web/src/tokens.css for the web app.",
    "compose": "gen-tokens.mjs writes OrreryTokens.kt in that shape: one object per top-level group, ink.1 becomes OrreryTokens.Ink.one, and each type entry is a TextStyle with its caps as a Boolean beside it (Type.label, then Type.labelCaps)"
  },

  "palette": {
    "crust": "#11111b",
    "mantle": "#181825",
    "base": "#1e1e2e",
    "surface0": "#313244",
    "surface1": "#45475a",
    "overlay0": "#6c7086",
    "overlay1": "#7f849c",
    "overlay2": "#9399b2",
    "subtext0": "#a6adc8",
    "text": "#cdd6f4",
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "lavender": "#b4befe",
    "blue": "#89b4fa",
    "sapphire": "#74c7ec",
    "sky": "#89dceb",
    "teal": "#94e2d5",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "peach": "#fab387",
    "maroon": "#eba0ac",
    "red": "#f38ba8",
    "mauve": "#cba6f7"
  },

  "surface": {
    "side": "{palette.crust}",
    "well": "{palette.mantle}",
    "page": "{palette.base}",
    "raised": "{palette.surface0}",
    "pressed": "{palette.surface1}",
    "overlay": "{palette.mantle}"
  },

  "line": {
    "soft": "{palette.surface0}",
    "firm": "{palette.surface1}",
    "glyph": "{palette.overlay0}"
  },

  "ink": {
    "1": "{palette.text}",
    "2": "{palette.subtext0}",
    "3": "{palette.overlay2}",
    "4": "{palette.overlay1}",
    "onAccent": "{palette.crust}"
  },

  "role": {
    "you": "{palette.mauve}",
    "focus": "{palette.mauve}",
    "primary": "{palette.mauve}",
    "place": "{palette.sapphire}",
    "attention": "{palette.peach}",
    "live": "{palette.yellow}",
    "ok": "{palette.green}",
    "bad": "{palette.red}",
    "halt": "{palette.maroon}",
    "engine": "{palette.teal}",
    "ref": "{palette.blue}",
    "new": "{palette.lavender}",
    "mark": "{palette.yellow}"
  },

  "state": {
    "working": "{role.live}",
    "waiting": "{role.attention}",
    "held": "{role.attention}",
    "done": "{role.ok}",
    "interrupted": "{role.halt}",
    "interrupting": "{role.halt}",
    "failed": "{role.bad}",
    "stopped": "{ink.3}",
    "limited": "{ink.3}",
    "idle": "{ink.3}"
  },

  "tone": {
    "plan": "{line.firm}",
    "run": "{role.live}",
    "mine": "{role.attention}",
    "bad": "{role.bad}",
    "acc": "{role.engine}",
    "ok": "{role.ok}"
  },

  "level": {
    "ok": "{palette.green}",
    "warn": "{palette.yellow}",
    "crit": "{palette.red}"
  },

  "series": {
    "1": "{palette.sky}",
    "2": "{palette.pink}",
    "3": "{palette.flamingo}",
    "4": "{palette.sapphire}",
    "5": "{palette.rosewater}"
  },

  "prose": {
    "heading": "{palette.sky}",
    "code": "{palette.flamingo}",
    "marker": "{palette.sky}"
  },

  "syntax": {
    "keyword": "{palette.mauve}",
    "string": "{palette.green}",
    "number": "{palette.peach}",
    "function": "{palette.blue}",
    "type": "{palette.yellow}",
    "comment": "{palette.overlay2}",
    "operator": "{palette.sky}"
  },

  "rule": {
    "series": {
      "note": "a series colour tells things apart from each other and means nothing else: one host stat from the next, one kind of contract row from another. It is taken in order."
    },
    "level": {
      "note": "a host stat's level is given by the server as ok, warn or crit; any other value draws as ok. At ok a stat keeps its series colour; at warn or crit its value and bar take the level's. A quantity is never peach: peach is a call on the owner."
    },
    "context": {
      "note": "context percent of window, clamped 0..100, drawn as five blocks of 20. Below limits[0] it takes level.ok (green), below limits[1] level.warn, from there level.crit.",
      "limits": [60, 80],
      "blocks": 5,
      "percentPerBlock": 20
    }
  },

  "alpha": {
    "tintFill": 0.1,
    "tintLine": 0.35,
    "scrim": 0.6
  },

  "ground": {
    "open": { "tint": "{role.focus}", "over": "{surface.side}", "alpha": 0.35 },
    "openHover": { "tint": "{role.focus}", "over": "{surface.side}", "alpha": 0.45 }
  },

  "font": {
    "mono": "\"Orrery Mono\", ui-monospace, \"JetBrains Mono\", Menlo, monospace",
    "weight": {
      "regular": 400,
      "bold": 700
    }
  },

  "type": {
    "label": { "size": 12, "line": 16, "weight": "{font.weight.bold}", "tracking": 0.06, "caps": true },
    "small": { "size": 13, "line": 20, "weight": "{font.weight.regular}", "tracking": 0, "caps": false },
    "body": { "size": 15, "line": 24, "weight": "{font.weight.regular}", "tracking": 0, "caps": false },
    "title": { "size": 18, "line": 28, "weight": "{font.weight.bold}", "tracking": 0, "caps": false },
    "display": { "size": 28, "line": 36, "weight": "{font.weight.bold}", "tracking": 0, "caps": false }
  },

  "space": {
    "2": 2,
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "24": 24,
    "32": 32,
    "48": 48
  },

  "radius": {
    "1": 4,
    "2": 8,
    "3": 12,
    "round": 999
  },

  "size": {
    "hairline": 1,
    "rail": 3,
    "glyph": 16,
    "dot": 6,
    "icon": 16,
    "meterBarWidth": 48,
    "meterBarHeight": 4,
    "contextBlock": 8,
    "controlDesk": 32,
    "controlTouch": 48,
    "gauge": 24,
    "orreryFull": 320
  },

  "layout": {
    "breakpointPhone": 760,
    "breakpointNarrow": 1250,
    "breakpointHeadNarrow": 900,
    "inboxWidth": 340,
    "inboxWidthNarrow": 316,
    "railWidth": 64,
    "readMeasureCh": 88,
    "gutterCh": 6,
    "pageMeasure": 1120,
    "pagePadDesk": 24,
    "pagePadPhone": 16,
    "turnGap": 32,
    "itemGap": 12
  },

  "elevation": {
    "overlay": { "x": 0, "y": 8, "blur": 24, "color": "{palette.crust}", "alpha": "{alpha.scrim}" },
    "side": { "x": 8, "y": 0, "blur": 24, "color": "{palette.crust}", "alpha": "{alpha.scrim}" },
    "sideEnd": { "x": -8, "y": 0, "blur": 24, "color": "{palette.crust}", "alpha": "{alpha.scrim}" }
  },

  "z": {
    "page": 0,
    "sticky": 5,
    "flyout": 10,
    "menu": 20,
    "notices": 30,
    "panel": 40
  },

  "motion": {
    "ease": {
      "out": [0.2, 0, 0, 1],
      "in": [0.4, 0, 1, 1],
      "linear": [0, 0, 1, 1]
    },
    "move": {
      "press": { "ms": 120, "ease": "{motion.ease.out}" },
      "state": { "ms": 200, "ease": "{motion.ease.out}" },
      "layout": { "ms": 280, "ease": "{motion.ease.out}" },
      "drill": { "ms": 320, "ease": "{motion.ease.out}" },
      "leave": { "ms": 200, "ease": "{motion.ease.in}" }
    },
    "loop": {
      "spin": { "ms": 1100 },
      "pulse": { "ms": 1800, "from": 1, "to": 0.25 },
      "blink": { "ms": 1100, "onShare": 0.55 }
    },
    "reduced": {
      "note": "with reduced motion every move is one linear step of this length and every loop holds still",
      "ms": 100
    },
    "distance": {
      "drill": 16
    }
  }
}
